# Sao chép file này thành ".env" (đặt trong thư mục backend/ khi chạy local) rồi điền giá trị thật.
# KHÔNG commit file ".env". Khi deploy, nhập các biến này trong Render Dashboard > Environment.

# --- Bắt buộc ---
# Chuỗi kết nối MongoDB Atlas (Connect > Drivers). Nhớ thay <password> và cho phép IP 0.0.0.0/0 trong Network Access.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
DB_NAME=chatapp
# Chuỗi ngẫu nhiên dài >= 32 ký tự, ví dụ: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=doi-chuoi-nay-thanh-mot-chuoi-ngau-nhien-dai

# --- CORS: để trống nếu chỉ dùng cùng domain (mặc định). Nhiều origin ngăn bằng dấu phẩy ---
CORS_ORIGINS=

# --- Lưu ảnh: điền đủ 3 biến để dùng Cloudinary; để trống thì tự dùng MongoDB GridFS ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- TURN (cần để gọi được khi 2 người khác mạng). Ví dụ Metered Open Relay ---
# TURN_URL có thể nhiều địa chỉ, ngăn bằng dấu phẩy
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# --- Tùy chọn ---
# STUN_URLS=stun:stun.l.google.com:19302
# CALL_RING_TIMEOUT=30
# MAX_CALL_PARTICIPANTS=4
