:root{
  --bg:#f3f5fa; --panel:#fff; --side:#1b2340; --side2:#273157; --text:#1c2430; --muted:#7a8596;
  --accent:#4f6df5; --accent2:#3b57e0; --danger:#e5484d; --ok:#2fb77a; --line:#e3e7ef; --mine:#4f6df5;
}
*{box-sizing:border-box;margin:0}
html,body{height:100%}
body{font:15px/1.45 system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;color:var(--text);background:var(--bg);overscroll-behavior:none}
.hidden{display:none!important}
.muted{color:var(--muted);font-weight:400;font-size:12px}
input,button{font:inherit;padding:10px 14px;border-radius:10px;border:1px solid #cdd4e0;background:#fff;color:inherit}
input:focus-visible,button:focus-visible{outline:2px solid var(--accent);outline-offset:1px}
button{background:var(--accent);color:#fff;border-color:var(--accent);cursor:pointer;transition:background .15s}
button:hover{background:var(--accent2)}
button.ghost{background:transparent;color:inherit;border-color:#cdd4e0}
button.ghost:hover{background:rgba(127,127,127,.12)}
button.small{padding:3px 10px;font-size:13px;border-radius:8px}
button.icon{background:transparent;color:var(--text);border:none;font-size:20px;padding:6px 10px;line-height:1}
button.icon:hover{background:#eef1f8}
button.danger{background:var(--danger);border-color:var(--danger)}
button.ok{background:var(--ok);border-color:var(--ok)}
button.round{border-radius:999px;padding:12px 22px}
button.off{background:#555;border-color:#555}

/* ---- Đăng nhập ---- */
#auth{height:100%;display:grid;place-items:center;background:linear-gradient(135deg,#1b2340,#4f6df5);padding:16px}
#authForm{background:#fff;padding:30px;border-radius:16px;width:min(380px,100%);display:flex;flex-direction:column;gap:12px;box-shadow:0 20px 50px rgba(0,0,0,.25)}
#authForm h1{font-size:28px;color:var(--accent)}
#authForm .sub{color:var(--muted);margin-bottom:6px}
#err{color:var(--danger);font-size:14px;min-height:20px}

/* ---- Bố cục chính ---- */
#app{height:100vh;height:100dvh;display:flex}
aside{width:290px;flex:none;background:var(--side);color:#c9d1e6;overflow-y:auto;display:flex;flex-direction:column}
aside h2{padding:16px 16px 6px;font-size:12px;letter-spacing:.06em;text-transform:uppercase;color:#8d99bd;font-weight:600;display:flex;justify-content:space-between;align-items:center}
.me{display:flex;justify-content:space-between;align-items:center;padding:14px 16px;border-bottom:1px solid var(--side2);color:#fff}
.me small{display:block;color:#8d99bd;font-size:12px}
.me button{color:#c9d1e6;border-color:#46528a}
.item{padding:9px 16px;cursor:pointer;display:flex;justify-content:space-between;align-items:center;gap:8px;margin:0 8px;border-radius:10px}
.item:hover{background:var(--side2)}
.item.active{background:var(--accent);color:#fff}
.item .name{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.dot{display:inline-block;width:9px;height:9px;border-radius:50%;background:#5b6794;margin-right:9px;flex:none}
.dot.on{background:#3ddc97;box-shadow:0 0 0 3px rgba(61,220,151,.2)}
.badge{background:var(--danger);color:#fff;border-radius:10px;font-size:12px;padding:0 7px;flex:none}
.live{font-size:13px}
.empty{padding:6px 16px;color:#7480a8;font-size:13px}

main{flex:1;display:flex;flex-direction:column;min-width:0;background:var(--panel)}
header{padding:8px 12px;border-bottom:1px solid var(--line);display:flex;align-items:center;gap:4px}
header .title{flex:1;min-width:0;display:flex;flex-direction:column;padding-left:6px}
header .title b{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
header .title small{color:var(--muted);font-size:12px}
header #joinCallBtn{background:var(--ok);color:#fff;font-size:13px;border-radius:999px;padding:6px 12px}
.back{display:none}
#msgs{flex:1;overflow-y:auto;padding:14px 18px;background:var(--bg);display:flex;flex-direction:column;gap:4px}
.placeholder{margin:auto;color:var(--muted);text-align:center;padding:20px}
.loadmore{text-align:center;color:var(--muted);font-size:12px;padding:4px}
.msg{max-width:min(75%,560px);display:flex;flex-direction:column;align-self:flex-start;margin-top:6px}
.msg.mine{align-self:flex-end;align-items:flex-end}
.msg .who{font-size:12px;color:var(--muted);margin:0 6px 2px}
.bubble{background:#fff;padding:8px 12px;border-radius:16px 16px 16px 4px;box-shadow:0 1px 1px rgba(0,0,0,.06);white-space:pre-wrap;overflow-wrap:anywhere}
.msg.mine .bubble{background:var(--mine);color:#fff;border-radius:16px 16px 4px 16px}
.bubble.img{padding:4px;background:#fff}
.bubble img{display:block;max-width:100%;max-height:320px;border-radius:12px;cursor:zoom-in}
.msg time{font-size:11px;color:var(--muted);margin:2px 6px 0}
#composer{display:flex;gap:8px;padding:10px 12px calc(10px + env(safe-area-inset-bottom));border-top:1px solid var(--line);background:var(--panel);align-items:center}
#composer input[type=text],#composer #text{flex:1;min-width:0;border-radius:999px}

/* ---- Modal ---- */
.overlay{position:fixed;inset:0;background:rgba(10,15,30,.55);display:grid;place-items:center;z-index:50;padding:16px}
.dialog{background:#fff;border-radius:16px;padding:20px;width:min(420px,100%);max-height:88vh;overflow-y:auto;display:flex;flex-direction:column;gap:12px}
.dialog h3{font-size:18px}
.dialog .row{display:flex;gap:10px;justify-content:flex-end;flex-wrap:wrap}
.checklist{display:flex;flex-direction:column;border:1px solid var(--line);border-radius:10px;max-height:240px;overflow-y:auto}
.checklist label,.memberRow{display:flex;align-items:center;gap:10px;padding:8px 12px;border-bottom:1px solid var(--line);cursor:pointer}
.memberRow{justify-content:space-between;cursor:default}
.checklist label:last-child,.memberRow:last-child{border-bottom:none}
.checklist input{width:auto;padding:0}
.incoming{align-items:center;text-align:center}
.avatar{width:44px;height:44px;border-radius:50%;background:var(--accent);color:#fff;display:grid;place-items:center;font-weight:700;font-size:18px}
.avatar.big{width:84px;height:84px;font-size:34px;animation:pulse 1.2s infinite}
@keyframes pulse{0%{box-shadow:0 0 0 0 rgba(79,109,245,.5)}100%{box-shadow:0 0 0 22px rgba(79,109,245,0)}}

/* ---- Màn hình cuộc gọi ---- */
#callScreen{position:fixed;inset:0;background:#0d1224;color:#fff;z-index:60;display:flex;flex-direction:column}
.callTop{padding:14px 18px;display:flex;justify-content:space-between;gap:10px;padding-top:calc(14px + env(safe-area-inset-top))}
#callStatus{color:#9fb0e8}
#tiles{flex:1;display:grid;gap:8px;padding:8px;min-height:0;grid-template-columns:1fr;position:relative}
#tiles.n2,#tiles.n3,#tiles.n4{grid-template-columns:1fr 1fr}
.tile{position:relative;background:#1b2340;border-radius:14px;overflow:hidden;min-height:0;display:grid;place-items:center}
.tile video{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;background:#000}
.tile.audio video{visibility:hidden}
.tile.nocam video{visibility:hidden}
.tile .label{position:absolute;left:10px;bottom:8px;background:rgba(0,0,0,.5);padding:2px 10px;border-radius:999px;font-size:13px;z-index:2}
.tile .avatar{z-index:1}
.tile:not(.audio):not(.nocam) .avatar{display:none}
.tile.local video{transform:scaleX(-1)}
/* Video local: ô nhỏ nổi ở góc khi chỉ có 1 người bên kia */
#tiles.n2.pip{grid-template-columns:1fr}
#tiles.n2.pip .tile.local{position:absolute;right:14px;bottom:14px;width:28%;max-width:200px;aspect-ratio:3/4;z-index:5;box-shadow:0 4px 18px rgba(0,0,0,.5)}
.callBar{display:flex;gap:12px;justify-content:center;padding:14px 12px calc(18px + env(safe-area-inset-bottom))}

#toasts{position:fixed;top:12px;left:50%;transform:translateX(-50%);display:flex;flex-direction:column;gap:8px;z-index:100;width:min(420px,92vw)}
.toast{background:#1c2430;color:#fff;padding:10px 14px;border-radius:12px;box-shadow:0 6px 20px rgba(0,0,0,.3);font-size:14px}
.toast.err{background:var(--danger)}

/* ---- Điện thoại: sidebar và khung chat chuyển qua lại ---- */
@media (max-width:720px){
  aside{width:100%}
  #app.chat-open aside{display:none}
  #app:not(.chat-open) main{display:none}
  .back{display:inline-block}
  .msg{max-width:88%}
  #tiles.n3,#tiles.n4{grid-template-columns:1fr 1fr}
}
